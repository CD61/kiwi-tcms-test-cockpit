{
	"manifest_version": 3,
	"name": "CD61 - Kiwi extension",
	"version":"0.2",
	
	"description": "Permet au testeur de suivre et mettre à jour les tests qu'ils doivent éxecuter. Fonctionne avec Kiwi TCMS",
	"icons": {
		"48": "icons/kiwi-48x48.png",
		"96": "icons/kiwi-96x96.png"
	},
	
	"side_panel": {
		"default_path": "sidepanel/sidepanel.html"
	},
	
	"background": {
		"service_worker": "scripts/background.js"
	},

	"permissions": ["sidePanel", "tabs"],
	
	"action": {
        "default_title": "Ouvrir CD61 - Kiwi"
    },
	
    "host_permissions": [
        "https://kiwi.orne.fr/*"
    ]	
}